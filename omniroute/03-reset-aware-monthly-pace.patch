+/**
+ * Fraction of the window still to elapse before its reset (0..1). `0.5` when the
+ * snapshot exposes no parseable reset — the same neutral value `getResetUrgency`
+ * falls back to, so a window without a reset date keeps a usable pace score.
+ */
+function getRemainingWindowFraction(
+  resetAt: string | null | undefined,
+  windowMs: number
+): number {
+  if (!resetAt) return 0.5;
+  const resetTime = parseResetTimeMs(resetAt);
+  if (!Number.isFinite(resetTime)) return 0.5;
+  const msUntilReset = resetTime - Date.now();
+  if (msUntilReset <= 0) return RESET_AWARE_PACE_MIN_WINDOW_FRACTION;
+  return Math.max(RESET_AWARE_PACE_MIN_WINDOW_FRACTION, clamp01(msUntilReset / windowMs));
+}
+
+/**
+ * Depletion-pace score: quota still available per unit of window time left
+ * (`remaining / fraction-until-reset`), squashed into [0,1) with `x / (1 + x)`
+ * so the combo's tieBand — an absolute delta on the 0..1 score scale — keeps its
+ * meaning.
+ *
+ * Highest pace wins: an account with 58% left and 15 days of runway (3.9 %/day)
+ * is consumed before one with 20% left and 10 days (2 %/day). Consuming the
+ * highest pace first keeps every account on a level depletion track — each one
+ * reaches zero at its own reset, so no quota expires unused, and it removes the
+ * self-reinforcing "the emptier account wins" loop of the pressure metric.
+ */
