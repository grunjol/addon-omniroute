+// ─── Domain cache mapping ────────────────────────────────────────────────────
+
+/**
+ * Read the domain quota cache for a connection and map it to the triple-window
+ * shape. Returns null when there is no cached data (background ticker hasn't
+ * run yet, no cookies configured, or the connection is unknown).
+ */
+async function tryDomainQuotaCache(
+  connectionId: string
+): Promise<OpencodeTripleWindowQuota | null> {
+  try {
+    // Lazy dynamic import (matches sessionStickiness.ts / quotaStrategies.ts):
+    // breaks the opencodeQuotaFetcher → domain/quotaCache → usage → usage/opencode
+    // static cycle, and keeps the domain read off the module-init path.
+    const { getQuotaCache } = await import("../../src/domain/quotaCache");
+    const entry = getQuotaCache(connectionId);
+    if (!entry?.quotas || Object.keys(entry.quotas).length === 0) return null;
+    return buildTripleWindowFromDomainQuotas(entry.quotas);
+  } catch {
+    return null; // fail open — never block routing on a cache read
+  }
+}
+
+/**
+ * Map the domain quota cache (populated by the 60s background ticker via
+ * getUsageForProvider → dashboard cookie scraper) into the triple-window shape
+ * the combo scoring consumes. Window keys on the domain cache follow the
+ * scraper's naming: "session" / "weekly" / "mcp_monthly".
+ */
+function buildTripleWindowFromDomainQuotas(
+  quotas: Record<string, { remainingPercentage?: number | null; resetAt?: string | null }>
+): OpencodeTripleWindowQuota | null {
+  const toWindow = (
+    key: string
+  ): { percentUsed: number; resetAt: string | null } | null => {
+    const entry = quotas[key];
+    if (!entry || typeof entry.remainingPercentage !== "number") return null;
+    const remaining = Math.max(0, Math.min(100, entry.remainingPercentage));
+    return {
+      percentUsed: (100 - remaining) / 100,
+      resetAt: entry.resetAt || null,
+    };
+  };
+
+  const window5h = toWindow("session");
+  const windowWeekly = toWindow("weekly");
+  const windowMonthly = toWindow("mcp_monthly");
+  const present = [window5h, windowWeekly, windowMonthly].filter(
+    (w): w is { percentUsed: number; resetAt: string | null } => w !== null
+  );
+  if (present.length === 0) return null;
+
+  const percentUsed = Math.max(...present.map((w) => w.percentUsed));
+  const windows: Record<string, { percentUsed: number; resetAt: string | null }> = {};
+  if (window5h) windows[OPENCODE_WINDOW_5H] = window5h;
+  if (windowWeekly) windows[OPENCODE_WINDOW_WEEKLY] = windowWeekly;
+  if (windowMonthly) windows[OPENCODE_WINDOW_MONTHLY] = windowMonthly;
+
+  return {
+    used: Math.round(percentUsed * 100),
+    total: 100,
+    percentUsed,
+    resetAt: present[0].resetAt,
+    windows,
+    window5h: window5h ?? { percentUsed: 0, resetAt: null },
+    windowWeekly: windowWeekly ?? { percentUsed: 0, resetAt: null },
+    windowMonthly: windowMonthly ?? { percentUsed: 0, resetAt: null },
+    limitReached: percentUsed >= 1 - 1e-9,
+  };
+}
+
